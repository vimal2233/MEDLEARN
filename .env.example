# MedLearn Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# SUPABASE CONFIGURATION
# Get these from your Supabase project dashboard:
# https://supabase.com/dashboard/project/_/settings/api
# ============================================
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# AI TUTOR CONFIGURATION (Optional)
# For AI-powered features, configure a backend endpoint
# ============================================
# EXPO_PUBLIC_AI_API_URL=https://your-backend.com/api/ai
# EXPO_PUBLIC_AI_API_KEY=your-api-key

# ============================================
# PUSH NOTIFICATIONS (Optional)
# For Expo push notifications
# ============================================
# EXPO_PUBLIC_EXPO_PUSH_TOKEN=your-expo-push-token

# ============================================
# ANALYTICS (Optional)
# ============================================
# EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
# NODE_ENV=development